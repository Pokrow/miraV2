# Шаблон окружения. Скопировать в .env и заполнить:
#     cp .env.example .env
# Файл .env в репозиторий не попадает — он в .gitignore.

# --- ОБЯЗАТЕЛЬНОЕ ---
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=

# Ключи Gemini через запятую. Чем больше, тем выше суточный потолок —
# но только если ключи из РАЗНЫХ проектов Google: квота считается на проект.
GEMINI_API_KEYS=

# Твой Telegram ID (узнать: @userinfobot). Без него админ-панель молча
# недоступна: обработчики просто игнорируют не-администратора.
ADMIN_ID=

# --- СЕТЬ ---
# Прокси для Telegram. Пусто — прямое подключение.
PROXY_URL=

# Прокси для Gemini. На РОССИЙСКОМ сервере обязателен: API Google оттуда
# недоступно, без прокси не работают ни расклады, ни эмбеддинги.
# Если не задан — используется PROXY_URL.
GEMINI_PROXY_URL=

# --- МОДЕЛИ ---
# Каскад от умной к лёгкой. Модель, которая стабильно отдаёт 503, лучше убрать:
# каждый запрос к ней — это несколько секунд ожидания впустую.
GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Модель-привратник для проверки смысла вопроса. По умолчанию — последняя из каскада.
GEMINI_GUARD_MODEL=
# Одновременных обращений к Gemini на весь бот.
GEMINI_MAX_CONCURRENCY=4
# Потолок длины ответа в токенах.
GEMINI_MAX_OUTPUT_TOKENS=1200

# --- ОПЛАТА ---
# Токен платёжного провайдера от @BotFather (ЮKassa, Т-Банк и т.п.).
# Пусто — оплата рублями скрыта, работают только звёзды Telegram.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=RUB

# --- ПОДДЕРЖКА ---
# @username или ссылка. Пусто — кнопка «Написать в поддержку» не показывается.
SUPPORT_CONTACT=

# --- ПУТИ И РАСПИСАНИЯ ---
# В Docker эти пути задаются в compose и указывают на том с данными.
DB_NAME=mira.db
KNOWLEDGE_DB=knowledge.db
BACKUP_DIR=backups
LOG_FILE=bot.log
LOCK_FILE=mira.lock

# Часовой пояс расписаний. Без него бэкап и напоминания считаются по времени
# сервера, а в контейнере это UTC.
TZ=Europe/Moscow
BACKUP_HOUR=4
BACKUP_KEEP=7
REMINDER_HOUR=11

# Сколько дней хранить отклонённые обращения. Расклады не удаляются никогда.
REQUEST_LOG_RETENTION_DAYS=90
